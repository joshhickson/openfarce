[Unit]
Description=OpenFARCE: endurance ledger for the MicroSD array
Documentation=https://github.com/joshhickson/openfarce
Requires=farce-assemble.service
After=farce-assemble.service

[Service]
Type=simple
Environment=FARCE_STATE_DIR=/etc/farce
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/openfarce
ExecStart=/usr/bin/python3 -m farce.endure --daemon
Restart=always
RestartSec=30
# The ledger is the whole point; losing it loses the measurement.
StateDirectory=farce

[Install]
WantedBy=multi-user.target
